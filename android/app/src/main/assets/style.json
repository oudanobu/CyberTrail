{
  "version": 8,
  "name": "Offline Style",
  "sources": {
    "offline-mbtiles": {
      "type": "raster",
      "tiles": [
        "mbtiles://{mbtiles_path}"
      ],
      "tileSize": 256,
      "maxzoom": 14
    }
  },
  "sprite": "asset://sprites/sprite",
  "glyphs": "asset://fonts/{fontstack}/{range}.pbf",
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#f8f4f0"
      }
    },
    {
      "id": "offline-layer",
      "type": "raster",
      "source": "offline-mbtiles"
    }
  ]
}
