<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/cyber_dark_gray">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <!-- Checkbox for multi-select (visible only during multi-select mode) -->
        <CheckBox
            android:id="@+id/cb_select_waypoint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:buttonTint="#EF4444"
            android:visibility="gone"
            android:layout_marginRight="8dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Top Row: Emoji, Name, and Favorite Star -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/tv_waypoint_emoji"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📍"
                    android:textSize="20sp"
                    android:layout_alignParentLeft="true"
                    android:layout_centerVertical="true" />

                <TextView
                    android:id="@+id/tv_waypoint_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toRightOf="@id/tv_waypoint_emoji"
                    android:layout_toLeftOf="@+id/btn_waypoint_fav_star"
                    android:layout_marginLeft="6dp"
                    android:layout_centerVertical="true"
                    android:text="补给站"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:singleLine="true" />

                <TextView
                    android:id="@+id/btn_waypoint_fav_star"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_alignParentRight="true"
                    android:gravity="center"
                    android:text="☆"
                    android:textColor="@color/cyber_amber"
                    android:textSize="22sp"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_centerVertical="true" />
            </RelativeLayout>

            <!-- Description -->
            <TextView
                android:id="@+id/tv_waypoint_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="山泉水源，水质甘甜，可补给"
                android:textColor="@color/cyber_light_gray"
                android:textSize="13sp"
                android:layout_marginBottom="8dp" />

            <!-- Specs Grid -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="坐标"
                        android:textColor="@color/cyber_light_gray"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/tv_waypoint_coords"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="39.9042, 116.4074"
                        android:textColor="@color/white"
                        android:textSize="11sp"
                        android:fontFamily="monospace" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.8"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="海拔"
                        android:textColor="@color/cyber_light_gray"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/tv_waypoint_elevation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="125 m"
                        android:textColor="@color/white"
                        android:textSize="11sp"
                        android:fontFamily="monospace" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.8"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="距离当前"
                        android:textColor="@color/cyber_light_gray"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/tv_waypoint_distance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1.2 km"
                        android:textColor="@color/cyber_green"
                        android:textSize="11sp"
                        android:fontFamily="monospace"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Bottom Actions Layout -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btn_action_locate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginRight="4dp"
                    android:background="#2222D3EE"
                    android:textColor="#22D3EE"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:padding="8dp"
                    android:text="🗺 查看"
                    android:clickable="true"
                    android:focusable="true"/>

                <TextView
                    android:id="@+id/btn_action_edit"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginLeft="4dp"
                    android:layout_marginRight="4dp"
                    android:background="#11FFFFFF"
                    android:textColor="@color/white"
                    android:textSize="11sp"
                    android:gravity="center"
                    android:padding="8dp"
                    android:text="✏ 编辑"
                    android:clickable="true"
                    android:focusable="true"/>

                <TextView
                    android:id="@+id/btn_action_delete"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginLeft="4dp"
                    android:background="#22EF4444"
                    android:textColor="#EF4444"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:padding="8dp"
                    android:text="🗑 删除"
                    android:clickable="true"
                    android:focusable="true"/>
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
