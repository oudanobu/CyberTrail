<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cyber_slate"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@color/cyber_dark_gray"
            android:paddingLeft="16dp"
            android:paddingRight="16dp">

            <TextView
                android:id="@+id/btn_detail_back"
                android:layout_width="40dp"
                android:layout_height="match_parent"
                android:gravity="center_vertical|left"
                android:text="⬅"
                android:textColor="@color/cyber_green"
                android:textSize="20sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/tv_detail_title"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_toRightOf="@id/btn_detail_back"
                android:gravity="center_vertical"
                android:text="轨迹详情"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginLeft="8dp" />

            <TextView
                android:id="@+id/btn_detail_export"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_alignParentRight="true"
                android:gravity="center_vertical"
                android:text="📤 导出"
                android:textColor="@color/cyber_green"
                android:textSize="14sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />
        </RelativeLayout>

        <!-- Stats Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▼ 轨迹多维核心参数指标"
                android:textColor="@color/cyber_green"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <!-- Stats Grid - Row 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <include layout="@layout/item_detail_stat_card" android:id="@+id/card_stat_distance" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                <include layout="@layout/item_detail_stat_card" android:id="@+id/card_stat_duration" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginLeft="6dp" />
                <include layout="@layout/item_detail_stat_card" android:id="@+id/card_stat_points" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginLeft="6dp" />
            </LinearLayout>

            <!-- Stats Grid - Row 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <include layout="@layout/item_detail_stat_card" android:id="@+id/card_stat_ascent" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                <include layout="@layout/item_detail_stat_card" android:id="@+id/card_stat_descent" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginLeft="6dp" />
                <include layout="@layout/item_detail_stat_card" android:id="@+id/card_stat_photos" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginLeft="6dp" />
            </LinearLayout>

            <!-- Stats Grid - Row 3 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <include layout="@layout/item_detail_stat_card" android:id="@+id/card_stat_max_ele" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                <include layout="@layout/item_detail_stat_card" android:id="@+id/card_stat_min_ele" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginLeft="6dp" />
                <include layout="@layout/item_detail_stat_card" android:id="@+id/card_stat_avg_speed" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginLeft="6dp" />
            </LinearLayout>

            <!-- Stats Grid - Row 4 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <include layout="@layout/item_detail_stat_card" android:id="@+id/card_stat_max_speed" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                <include layout="@layout/item_detail_stat_card" android:id="@+id/card_stat_start_time" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="2" android:layout_marginLeft="6dp" />
            </LinearLayout>

            <!-- Stats Grid - Row 5 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <include layout="@layout/item_detail_stat_card" android:id="@+id/card_stat_end_time" android:layout_width="match_parent" android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#1AFFFFFF"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp" />

        <!-- Map section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentLeft="true"
                    android:layout_centerVertical="true"
                    android:text="▼ 轨迹空间分布与回放系统"
                    android:textColor="@color/cyber_green"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btn_locate_track"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    android:background="#2210B981"
                    android:textColor="@color/cyber_green"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:text="🎯 查看地图"
                    android:clickable="true"
                    android:focusable="true"/>
            </RelativeLayout>

            <!-- Map View Container with Photo Linkage Pop-up Overlay -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:background="@color/cyber_dark_gray">

                <!-- Mapbox MapView -->
                <com.mapbox.mapboxsdk.maps.MapView
                    android:id="@+id/detail_map_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <!-- Photo Pop-up Overlay -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/card_photo_popup"
                    android:layout_width="160dp"
                    android:layout_height="160dp"
                    android:layout_alignParentRight="true"
                    android:layout_alignParentBottom="true"
                    android:layout_margin="12dp"
                    app:cardCornerRadius="8dp"
                    app:cardBackgroundColor="@color/cyber_dark_gray"
                    app:cardElevation="6dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center">

                        <ImageView
                            android:id="@+id/img_photo_popup_thumbnail"
                            android:layout_width="match_parent"
                            android:layout_height="120dp"
                            android:scaleType="centerCrop"
                            android:background="#22FFFFFF" />

                        <TextView
                            android:id="@+id/tv_photo_popup_desc"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="点击查看原图"
                            android:textColor="@color/cyber_amber"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:background="#1AAFFF00" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </RelativeLayout>

            <!-- Replay Control Panel -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/cyber_dark_gray"
                android:padding="12dp"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/tv_detail_replay_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="👁 轨迹回放: 停止"
                    android:textColor="@color/cyber_light_gray"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/tv_detail_replay_progress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="进度: 0 / 0 | 海拔: --m | 距离: 0.00km"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:layout_marginBottom="8dp" />

                <!-- Play Controls Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:id="@+id/btn_replay_start"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginRight="4dp"
                        android:background="#2210B981"
                        android:textColor="@color/cyber_green"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:padding="10dp"
                        android:text="▶ 播放"
                        android:clickable="true"
                        android:focusable="true"/>

                    <TextView
                        android:id="@+id/btn_replay_pause"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginLeft="4dp"
                        android:layout_marginRight="4dp"
                        android:background="#22F59E0B"
                        android:textColor="@color/cyber_amber"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:padding="10dp"
                        android:text="⏸ 暂停"
                        android:clickable="true"
                        android:focusable="true"/>

                    <TextView
                        android:id="@+id/btn_replay_stop"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginLeft="4dp"
                        android:background="#22EF4444"
                        android:textColor="#EF4444"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:padding="10dp"
                        android:text="⏹ 停止"
                        android:clickable="true"
                        android:focusable="true"/>
                </LinearLayout>

                <!-- Speed controls Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="播放速度："
                        android:textColor="@color/cyber_light_gray"
                        android:textSize="11sp"
                        android:layout_marginRight="8dp" />

                    <TextView
                        android:id="@+id/btn_speed_0_5"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginRight="3dp"
                        android:background="#1AFFFFFF"
                        android:textColor="@color/white"
                        android:textSize="11sp"
                        android:gravity="center"
                        android:padding="6dp"
                        android:text="0.5x"
                        android:clickable="true"
                        android:focusable="true"/>

                    <TextView
                        android:id="@+id/btn_speed_1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginLeft="3dp"
                        android:layout_marginRight="3dp"
                        android:background="#2238BDF8"
                        android:textColor="#38BDF8"
                        android:textSize="11sp"
                        android:gravity="center"
                        android:padding="6dp"
                        android:text="1x"
                        android:clickable="true"
                        android:focusable="true"/>

                    <TextView
                        android:id="@+id/btn_speed_2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginLeft="3dp"
                        android:layout_marginRight="3dp"
                        android:background="#1AFFFFFF"
                        android:textColor="@color/white"
                        android:textSize="11sp"
                        android:gravity="center"
                        android:padding="6dp"
                        android:text="2x"
                        android:clickable="true"
                        android:focusable="true"/>

                    <TextView
                        android:id="@+id/btn_speed_5"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginLeft="3dp"
                        android:layout_marginRight="3dp"
                        android:background="#1AFFFFFF"
                        android:textColor="@color/white"
                        android:textSize="11sp"
                        android:gravity="center"
                        android:padding="6dp"
                        android:text="5x"
                        android:clickable="true"
                        android:focusable="true"/>

                    <TextView
                        android:id="@+id/btn_speed_10"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginLeft="3dp"
                        android:background="#1AFFFFFF"
                        android:textColor="@color/white"
                        android:textSize="11sp"
                        android:gravity="center"
                        android:padding="6dp"
                        android:text="10x"
                        android:clickable="true"
                        android:focusable="true"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#1AFFFFFF"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp" />

        <!-- Profile Chart section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▼ 轨迹运动/地形剖面统计曲线"
                android:textColor="@color/cyber_green"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <!-- Custom Profile Chart View -->
            <com.cybertrail.app.gis.TrackProfileChartView
                android:id="@+id/profile_chart_view"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:background="@color/cyber_dark_gray" />

            <!-- Legend and Chart Toggle -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="12dp">

                <TextView
                    android:id="@+id/btn_toggle_chart_ele"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#2222D3EE"
                    android:textColor="#22D3EE"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:text="■ 海拔曲线 (m)"
                    android:clickable="true"
                    android:focusable="true"/>

                <TextView
                    android:id="@+id/btn_toggle_chart_speed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#1AFFFFFF"
                    android:textColor="@color/white"
                    android:textSize="11sp"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:layout_marginLeft="12dp"
                    android:text="■ 速度曲线 (m/s)"
                    android:clickable="true"
                    android:focusable="true"/>

                <TextView
                    android:id="@+id/btn_toggle_chart_dist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#1AFFFFFF"
                    android:textColor="@color/white"
                    android:textSize="11sp"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:layout_marginLeft="12dp"
                    android:text="■ 距离曲线 (km)"
                    android:clickable="true"
                    android:focusable="true"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
