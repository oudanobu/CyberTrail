<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="10dp"
    android:layout_marginEnd="10dp"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    app:cardCornerRadius="10dp"
    app:cardElevation="3dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Header: Icon, Name and Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Entity type icon indicator -->
            <TextView
                android:id="@+id/tv_icon_indicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📁"
                android:textSize="20sp"
                android:layout_marginEnd="10dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_weight="1">

                <TextView
                    android:id="@+id/tv_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Directory Item"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#222222" />

                <TextView
                    android:id="@+id/tv_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Subtitle description goes here"
                    android:textSize="11sp"
                    android:textColor="#777777"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- Status Indicator badge -->
            <TextView
                android:id="@+id/tv_status_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="已识别"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="4dp"
                android:background="#4CAF50"
                android:gravity="center"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <!-- Detailed metrics and bounds for map items -->
        <TextView
            android:id="@+id/tv_details"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="12sp"
            android:textColor="#555555"
            android:lineSpacingMultiplier="1.2"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/progress_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:visibility="gone" />

        <!-- Button actions strip -->
        <LinearLayout
            android:id="@+id/layout_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="12dp"
            android:visibility="gone">

            <!-- Primary 2-by-2 Actions -->
            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:rowCount="2"
                android:alignmentMode="alignBounds">

                <!-- 1. Open Download Page -->
                <Button
                    android:id="@+id/btn_open_page"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="3dp"
                    android:backgroundTint="#1976D2"
                    android:textColor="#FFFFFF"
                    android:text="打开网页"
                    android:textSize="11sp"
                    android:padding="0dp" />

                <!-- 2. Copy Download Link -->
                <Button
                    android:id="@+id/btn_copy_url"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="3dp"
                    android:backgroundTint="#00897B"
                    android:textColor="#FFFFFF"
                    android:text="复制地址"
                    android:textSize="11sp"
                    android:padding="0dp" />

                <!-- 3. GitHub Resource -->
                <Button
                    android:id="@+id/btn_github"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="3dp"
                    android:backgroundTint="#455A64"
                    android:textColor="#FFFFFF"
                    android:text="GitHub资源"
                    android:textSize="11sp"
                    android:padding="0dp" />

                <!-- 4. Import Local -->
                <Button
                    android:id="@+id/btn_import"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="3dp"
                    android:backgroundTint="#E65100"
                    android:textColor="#FFFFFF"
                    android:text="导入本地"
                    android:textSize="11sp"
                    android:padding="0dp" />
            </GridLayout>

            <!-- 5. Delete Button (Shows only when downloaded) -->
            <Button
                android:id="@+id/btn_delete"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="6dp"
                android:backgroundTint="#D32F2F"
                android:textColor="#FFFFFF"
                android:text="❌ 卸载并删除本地瓦片数据"
                android:textSize="11sp"
                android:padding="0dp"
                android:visibility="gone" />
        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
