<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="false"
    android:background="@color/cyber_slate">

    <!-- Screen Content: Map View and the ☰ Button -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- MapLibre MapView -->
        <com.mapbox.mapboxsdk.maps.MapView
            android:id="@+id/mapView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Menu button ☰ -->
        <TextView
            android:id="@+id/btn_menu"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentLeft="true"
            android:layout_alignParentTop="true"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="36dp"
            android:background="#E60F172A"
            android:gravity="center"
            android:text="☰"
            android:textColor="@color/cyber_green"
            android:textSize="24sp"
            android:textStyle="bold"
            android:elevation="12dp"
            android:clickable="true"
            android:focusable="true"/>

        <!-- Location Info Panel (🛰️ 离线定位面板) -->
        <LinearLayout
            android:id="@+id/panel_location_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_alignParentTop="true"
            android:layout_marginTop="36dp"
            android:layout_marginRight="16dp"
            android:background="@drawable/location_panel_bg"
            android:orientation="vertical"
            android:padding="12dp"
            android:elevation="12dp"
            android:minWidth="150dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🛰️ 离线定位系统"
                android:textColor="@color/cyber_green"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp"/>

            <TextView
                android:id="@+id/tv_panel_lat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lat: 获取中..."
                android:textColor="@color/white"
                android:textSize="11sp"
                android:layout_marginBottom="2dp"
                android:fontFamily="monospace"/>

            <TextView
                android:id="@+id/tv_panel_lon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lon: 获取中..."
                android:textColor="@color/white"
                android:textSize="11sp"
                android:layout_marginBottom="2dp"
                android:fontFamily="monospace"/>

            <TextView
                android:id="@+id/tv_panel_alt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Alt: 获取中..."
                android:textColor="@color/white"
                android:textSize="11sp"
                android:layout_marginBottom="2dp"
                android:fontFamily="monospace"/>

            <TextView
                android:id="@+id/tv_panel_accuracy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Accuracy: 获取中..."
                android:textColor="@color/cyber_amber"
                android:textSize="11sp"
                android:layout_marginBottom="2dp"
                android:fontFamily="monospace"/>

            <TextView
                android:id="@+id/tv_panel_speed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Speed: 获取中..."
                android:textColor="@color/white"
                android:textSize="11sp"
                android:layout_marginBottom="2dp"
                android:fontFamily="monospace"/>

            <TextView
                android:id="@+id/tv_panel_bearing"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bearing: 获取中..."
                android:textColor="@color/white"
                android:textSize="11sp"
                android:fontFamily="monospace"/>
        </LinearLayout>

        <!-- Track Control Panel (🛤️ 轨迹记录面板) -->
        <LinearLayout
            android:id="@+id/panel_track_control"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:layout_alignParentBottom="true"
            android:layout_toLeftOf="@id/btn_locate"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="12dp"
            android:layout_marginBottom="36dp"
            android:background="@drawable/location_panel_bg"
            android:orientation="vertical"
            android:padding="10dp"
            android:elevation="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">

                <TextView
                    android:id="@+id/tv_track_status"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🛤️ 轨迹: 停止记录"
                    android:textColor="@color/cyber_light_gray"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_track_stats"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="点数: 0 | 时间: 0s"
                    android:textColor="@color/white"
                    android:textSize="11sp"
                    android:fontFamily="monospace" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <!-- Start Recording -->
                <TextView
                    android:id="@+id/btn_track_start"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginRight="4dp"
                    android:background="@drawable/track_btn_green_bg"
                    android:textColor="@color/cyber_green"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:text="▶ 开始"
                    android:clickable="true"
                    android:focusable="true"/>

                <!-- Pause Recording -->
                <TextView
                    android:id="@+id/btn_track_pause"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginRight="4dp"
                    android:background="@drawable/track_btn_amber_bg"
                    android:textColor="@color/cyber_amber"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:text="⏸ 暂停"
                    android:visibility="gone"
                    android:clickable="true"
                    android:focusable="true"/>

                <!-- Resume Recording -->
                <TextView
                    android:id="@+id/btn_track_resume"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginRight="4dp"
                    android:background="@drawable/track_btn_green_bg"
                    android:textColor="@color/cyber_green"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:text="▶ 恢复"
                    android:visibility="gone"
                    android:clickable="true"
                    android:focusable="true"/>

                <!-- Stop Recording -->
                <TextView
                    android:id="@+id/btn_track_stop"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/track_btn_red_bg"
                    android:textColor="#FFEF4444"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:text="■ 停止"
                    android:visibility="gone"
                    android:clickable="true"
                    android:focusable="true"/>

                <!-- Manual Save -->
                <TextView
                    android:id="@+id/btn_track_save"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginLeft="4dp"
                    android:background="@drawable/track_btn_blue_bg"
                    android:textColor="#FF38BDF8"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:text="💾 保存"
                    android:visibility="gone"
                    android:clickable="true"
                    android:focusable="true"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Camera Button 📷 拍照 -->
        <TextView
            android:id="@+id/btn_camera"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_above="@id/btn_locate"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/locate_btn_bg"
            android:textColor="@color/cyber_green"
            android:textSize="14sp"
            android:textStyle="bold"
            android:paddingLeft="18dp"
            android:paddingRight="18dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:text="📷 拍照"
            android:gravity="center"
            android:elevation="12dp"
            android:clickable="true"
            android:focusable="true"/>

        <!-- Locate Button ◎ 定位 -->
        <TextView
            android:id="@+id/btn_locate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_alignParentBottom="true"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="36dp"
            android:background="@drawable/locate_btn_bg"
            android:textColor="@color/cyber_green"
            android:textSize="14sp"
            android:textStyle="bold"
            android:paddingLeft="18dp"
            android:paddingRight="18dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:text="◎ 定位"
            android:gravity="center"
            android:elevation="12dp"
            android:clickable="true"
            android:focusable="true"/>

    </RelativeLayout>

    <!-- Side Menu / Drawer (sliding from start/left) -->
    <ScrollView
        android:id="@+id/drawer_scroll_view"
        android:layout_width="320dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@drawable/drawer_bg"
        android:padding="16dp"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Drawer Header: title and drawer close/toggle ☰ button -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:layout_marginTop="20dp">

                <!-- Drawer close toggle ☰ button -->
                <TextView
                    android:id="@+id/btn_menu_drawer_close"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_alignParentLeft="true"
                    android:layout_alignParentTop="true"
                    android:background="#22FFFFFF"
                    android:gravity="center"
                    android:text="☰"
                    android:textColor="@color/cyber_green"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toRightOf="@id/btn_menu_drawer_close"
                    android:layout_centerVertical="true"
                    android:layout_marginLeft="16dp"
                    android:text="CyberTrail 诊断中心"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            </RelativeLayout>

            <!-- Top HUD: GIS Telemetry -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#DD0F172A"
                android:orientation="vertical"
                android:padding="12dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="▼ 实时地形/GIS遥测"
                    android:textColor="@color/cyber_green"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/hud_elevation"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="海拔: 获取中..."
                        android:textColor="@color/white"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/hud_slope"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="坡度: 获取中..."
                        android:textColor="@color/white"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/hud_aspect"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="坡向: 获取中..."
                        android:textColor="@color/white"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Bottom HUD: MBTiles Diagnosis & GPS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#DD0F172A"
                android:orientation="vertical"
                android:padding="12dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="▼ 离线底图底子/物理包状态诊断"
                    android:textColor="@color/cyber_amber"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/hud_mbtiles_path"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="路径: "
                    android:textColor="@color/cyber_light_gray"
                    android:textSize="11sp"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/hud_mbtiles_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="物理文件: 检测中..."
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/hud_tile_count"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="地图瓦片数: 检测中..."
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/hud_style_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Style加载: 等待加载..."
                    android:textColor="@color/cyber_green"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Track Manager Panel (🛤️ 轨迹管理中心) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#DD0F172A"
                android:orientation="vertical"
                android:padding="12dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="▼ 离线轨迹与导入导出管理"
                    android:textColor="@color/cyber_green"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <!-- Layer Controls -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="图层控制:"
                        android:textColor="@color/cyber_light_gray"
                        android:textSize="11sp"
                        android:layout_marginEnd="8dp" />

                    <CheckBox
                        android:id="@+id/cb_layer_track"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="轨迹"
                        android:textColor="@color/cyber_green"
                        android:textSize="11sp"
                        android:checked="true"
                        android:layout_marginEnd="10dp"
                        android:buttonTint="@color/cyber_green" />

                    <CheckBox
                        android:id="@+id/cb_layer_waypoint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="航点"
                        android:textColor="@color/cyber_green"
                        android:textSize="11sp"
                        android:checked="true"
                        android:layout_marginEnd="10dp"
                        android:buttonTint="@color/cyber_green" />

                    <CheckBox
                        android:id="@+id/cb_layer_photo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="照片"
                        android:textColor="@color/cyber_green"
                        android:textSize="11sp"
                        android:checked="true"
                        android:buttonTint="@color/cyber_green" />
                </LinearLayout>

                <!-- Import GPX Button -->
                <TextView
                    android:id="@+id/btn_track_import_gpx"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#2210B981"
                    android:textColor="@color/cyber_green"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:padding="10dp"
                    android:layout_marginBottom="10dp"
                    android:text="📥 导入 GPX 轨迹文件"
                    android:clickable="true"
                    android:focusable="true"/>

                <!-- Import Photo Button -->
                <TextView
                    android:id="@+id/btn_photo_import"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#223B82F6"
                    android:textColor="#3B82F6"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:padding="10dp"
                    android:layout_marginBottom="10dp"
                    android:text="📸 导入照片生成锚点"
                    android:clickable="true"
                    android:focusable="true"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="历史轨迹列表:"
                    android:textColor="@color/cyber_light_gray"
                    android:textSize="11sp"
                    android:layout_marginBottom="6dp" />

                <!-- Dynamic Track List Container -->
                <LinearLayout
                    android:id="@+id/drawer_track_list_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- Floating Draggable, scrollable, collapsible diagnostic HUD panel -->
            <LinearLayout
                android:id="@+id/hud_diagnostic_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#E60F172A"
                android:orientation="vertical"
                android:padding="8dp">

                <TextView
                    android:id="@+id/hud_diagnostic_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="▼ 诊断信息"
                    android:textColor="@color/cyber_amber"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:padding="6dp"
                    android:background="#22FFFFFF"
                    android:clickable="true"
                    android:focusable="true"/>

                <LinearLayout
                    android:id="@+id/hud_diagnostic_buttons"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="2">

                        <TextView
                            android:id="@+id/btn_copy_diagnostic"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginRight="4dp"
                            android:background="#44FFFFFF"
                            android:text="📋 复制诊断信息"
                            android:textColor="#FFFFFF"
                            android:textSize="9sp"
                            android:gravity="center"
                            android:padding="6dp"
                            android:clickable="true"
                            android:focusable="true"/>

                        <TextView
                            android:id="@+id/btn_copy_json"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginLeft="4dp"
                            android:background="#44FFFFFF"
                            android:text="📋 复制Style JSON"
                            android:textColor="#FFFFFF"
                            android:textSize="9sp"
                            android:gravity="center"
                            android:padding="6dp"
                            android:clickable="true"
                            android:focusable="true"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/btn_export_diagnostic"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="#44FFFFFF"
                        android:text="📤 导出诊断TXT"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp"
                        android:gravity="center"
                        android:padding="6dp"
                        android:clickable="true"
                        android:focusable="true"/>

                    <TextView
                        android:id="@+id/btn_mbtiles_scan"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="#22D3EE"
                        android:text="🔍 MBTiles Coverage Scan"
                        android:textColor="#0F172A"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:padding="6dp"
                        android:clickable="true"
                        android:focusable="true"/>
                </LinearLayout>

                <ScrollView
                    android:id="@+id/hud_diagnostic_scroll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp">

                    <TextView
                        android:id="@+id/hud_diagnostic_counters"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/cyber_amber"
                        android:textSize="12sp" />
                </ScrollView>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</androidx.drawerlayout.widget.DrawerLayout>
