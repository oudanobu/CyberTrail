<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/cyber_slate">

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/cyber_dark_gray"
        android:paddingLeft="16dp"
        android:paddingRight="16dp">

        <TextView
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:gravity="center_vertical|left"
            android:text="⬅"
            android:textColor="@color/cyber_green"
            android:textSize="20sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_toRightOf="@id/btn_back"
            android:gravity="center_vertical"
            android:text="➕ 新建路线"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginLeft="8dp" />

        <TextView
            android:id="@+id/btn_save"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentRight="true"
            android:gravity="center"
            android:text="💾 保存"
            android:textColor="@color/cyber_green"
            android:textSize="15sp"
            android:textStyle="bold"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:clickable="true"
            android:focusable="true" />
    </RelativeLayout>

    <!-- Route Basic Info Inputs -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/cyber_dark_gray"
        android:padding="12dp"
        android:layout_marginBottom="8dp">

        <EditText
            android:id="@+id/et_route_name"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="#1AFFFFFF"
            android:hint="请输入路线名称 (如: 徒步越野挑战线)"
            android:textColorHint="@color/cyber_light_gray"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:maxLines="1"
            android:inputType="text"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/et_route_desc"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="#1AFFFFFF"
            android:hint="请输入路线描述/备注信息..."
            android:textColorHint="@color/cyber_light_gray"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:padding="10dp"
            android:gravity="top|left"
            android:inputType="textMultiLine" />
    </LinearLayout>

    <!-- Route Stats & Selected Waypoints Sequence -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1A10B981"
        android:padding="12dp"
        android:layout_marginBottom="8dp">

        <!-- Live Stats Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">

            <TextView
                android:id="@+id/tv_stats_distance"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="总长: 0.00 km"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_stats_time"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.2"
                android:text="预计时间: --"
                android:textColor="@color/cyber_green"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_stats_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="已选: 0 个点"
                android:textColor="@color/white"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Horizontal scroll of selected waypoints sequence -->
        <HorizontalScrollView
            android:id="@+id/scroll_selected_sequence"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:scrollbars="none"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/layout_selected_sequence"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingLeft="4dp"
                android:paddingRight="4dp" />
        </HorizontalScrollView>
    </LinearLayout>

    <!-- Available Waypoints Selection Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:layout_weight="1">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/cyber_dark_gray"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/tv_section_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📍 选择航点加入路线"
                android:textColor="@color/cyber_light_gray"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/et_search_waypoints"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_below="@id/tv_section_title"
                android:background="#1AFFFFFF"
                android:hint="🔍 搜索候选航点..."
                android:textColorHint="@color/cyber_light_gray"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:maxLines="1"
                android:inputType="text" />
        </RelativeLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_available_waypoints"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="8dp"
                android:clipToPadding="false"
                android:scrollbars="vertical" />

            <!-- Empty State -->
            <LinearLayout
                android:id="@+id/layout_empty_waypoints"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="32dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📍"
                    android:textSize="48sp"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="没有可选择的航点"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="请先返回地图页面，长按地图位置创建一些航点"
                    android:textColor="@color/cyber_light_gray"
                    android:textSize="11sp"
                    android:gravity="center" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
